<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.edu-workspace.server</string>
    <key>WorkingDirectory</key>
    <string>/Users/{user}/工作/github/edu-workspace</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/{user}/.local/share/fnm/node-versions/v20.19.6/installation/bin/node</string>
        <string>/Users/{user}/工作/github/edu-workspace/server/dist/index.js</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>NODE_ENV</key>
        <string>production</string>
        <key>PORT</key>
        <string>4000</string>
        <key>CLIENT_ORIGIN</key>
        <string>*</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>/tmp/edu-workspace-server.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/edu-workspace-server.error.log</string>
</dict>
</plist>