<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList 1.0//EN"?>
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.edu-workspace.autodeploy</string>
    <key>WorkingDirectory</key>
    <string>/Users/{user}/工作/github/edu-workspace</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/{user}/工作/github/edu-workspace/scripts/auto-deploy-main.sh</string>
    </array>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/{user}/.local/share/fnm/node-versions/v20.19.6/installation/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/edu-workspace-autodeploy.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/edu-workspace-autodeploy.error.log</string>
</dict>
</plist>
