[Unit]
Description=edu-workspace API server
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/edu-workspace
EnvironmentFile=/etc/edu-workspace/edu-workspace.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node server/dist/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/edu-workspace

[Install]
WantedBy=multi-user.target
