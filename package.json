{
  "name": "edu-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "教材/教辅 PDF 后台扫描导入、REST API 管理、前端阅读批注与错题裁剪归类系统",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "deploy:now": "./scripts/auto-deploy-main.sh",
    "setup:ssh": "./scripts/setup-github-ssh.sh",
    "build": "npm run build:server && npm run build:client",
    "build:prod": "npm run build:server && npm run build:client:prod",
    "dev:server": "PORT=4001 CLIENT_ORIGIN=http://localhost:5174 npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client -- --port 5174",
    "build:server": "npm run build --workspace=server",
    "build:client": "VITE_APP_ENV=${VITE_APP_ENV:-TEST} npm run build --workspace=client",
    "build:client:prod": "VITE_APP_ENV=PROD npm run build --workspace=client",
    "start:server": "npm run start --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
