{
  "name": "edu-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "教材/教辅 PDF 后台扫描导入、REST API 管理、前端阅读批注与错题裁剪归类系统",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "PORT=4001 CLIENT_ORIGIN=http://localhost:5174 npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client -- --port 5174",
    "dev": "./scripts/dev-local.sh",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "build": "npm run build:server && npm run build:client",
    "start:server": "npm run start --workspace=server",
    "start:prod": "npm run build && npm run start:server",
    "deploy:now": "./scripts/auto-deploy-main.sh"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
