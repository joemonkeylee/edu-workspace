DATABASE_URL="mysql://root:root@localhost:3306/edu_workspace"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
STORAGE_DIR="./storage"
# MySQL 客户端 bin 目录(可选):当 mysqldump/mysql 不在系统 PATH 时配置此项
# Windows 示例:MYSQL_BIN_DIR="D:\mysql-8.0.19-winx64\bin"
# 配置后数据库备份/还原功能会用此目录下的 mysqldump.exe / mysql.exe
# MYSQL_BIN_DIR=
