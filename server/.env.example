DATABASE_URL="mysql://root:root@localhost:3306/edu_workspace"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
# 本地模式的资源目录；远端文件服务进程也通过此变量设置自己的资源根目录。
STORAGE_DIR="./storage"
# 独立文件服务（Windows/Debian 均可）；远端主机应通过 HTTPS 反向代理对外提供服务。
FILE_SERVICE_HOST=127.0.0.1
FILE_SERVICE_PORT=4010
# 至少 32 个随机字符；不要提交真实密钥。
FILE_SERVICE_TOKEN=
# 应用端切换远端 PDF 存储时设置：
PDF_STORAGE_MODE=local
PDF_STORAGE_API_URL=
PDF_STORAGE_TOKEN=
# MySQL 客户端 bin 目录(可选):当 mysqldump/mysql 不在系统 PATH 时配置此项
# Windows 示例:MYSQL_BIN_DIR="D:\mysql-8.0.19-winx64\bin"
# 配置后数据库备份/还原功能会用此目录下的 mysqldump.exe / mysql.exe
# MYSQL_BIN_DIR=
