generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model User {
  id            Int      @id @default(autoincrement())
  phone         String   @unique @db.VarChar(20)
  email         String?  @unique @db.VarChar(128)
  password      String   @db.VarChar(255)
  isAdmin       Boolean  @default(false)
  role          String   @default("student") @db.VarChar(20) // student | teacher | admin
  nickName      String   @default("") @db.VarChar(64)
  avatar        String   @default("") @db.VarChar(512)
  status        String   @default("normal") @db.VarChar(20) // normal | disabled
  maxDevices    Int      @default(3)
  tokenVersion  Int      @default(0) // increment to invalidate all existing tokens
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  refreshTokens RefreshToken[]
  annotations   Annotation[]
  mistakes      Mistake[]
  assignments   Assignment[]
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique @db.VarChar(255)
  deviceInfo String   @default("") @db.VarChar(255)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
}

model Book {
  id          Int      @id @default(autoincrement())
  title       String
  category    String
  grade       String   @default("")
  subject     String   @default("")
  batchId     String   @default("")
  coverPage   Int      @default(1)
  totalPages  Int
  storagePath String
  fileHash    String?  @db.VarChar(64)
  sourcePaths Json?    @default("[]")
  tocJson     Json
  attributes  Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([fileHash])
  @@index([category])
  @@index([grade])
  @@index([subject])
  @@unique([title, category])
  annotations Annotation[]
  mistakes    Mistake[]
  assignments Assignment[]
}

model Assignment {
  id        Int      @id @default(autoincrement())
  bookId    Int
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("") @db.VarChar(255)
  subject   String   @default("") @db.VarChar(64)
  status    String   @default("draft") @db.VarChar(20) // draft | submitted | graded | returned
  gradedBy  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  gradedAt  DateTime?

  strokes AssignmentStroke[]

  @@index([bookId])
  @@index([userId])
}

model AssignmentStroke {
  id           Int      @id @default(autoincrement())
  assignmentId Int
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  pageNumber   Int
  layer        String   @default("student") @db.VarChar(10) // student | teacher
  tool         String   @default("pen") @db.VarChar(20) // pen | highlighter
  color        String   @default("#000000") @db.VarChar(20)
  width        Float    @default(2)
  points       Json     // [{x, y, p}] normalized 0-1
  createdAt    DateTime @default(now())

  @@index([assignmentId])
  @@index([assignmentId, pageNumber])
}

model Annotation {
  id          Int      @id @default(autoincrement())
  bookId      Int
  book        Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageNumber  Int
  type        String
  contentJson Json
  tags        String?
  createdAt   DateTime @default(now())

  mistakes Mistake[]

  @@index([userId])
  @@index([bookId, pageNumber])
}

model Mistake {
  id           Int         @id @default(autoincrement())
  annotationId Int
  annotation   Annotation  @relation(fields: [annotationId], references: [id], onDelete: Cascade)
  bookId       Int
  book         Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  userId       Int?
  user         User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageNumber   Int
  imagePath    String
  subject      String
  tags         String?
  reviewStatus Int         @default(0)
  createdAt    DateTime    @default(now())

  @@index([bookId])
  @@index([annotationId])
  @@index([subject])
  @@index([userId])
}
