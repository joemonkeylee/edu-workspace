generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model User {
  id         Int      @id @default(autoincrement())
  phone      String   @unique @db.VarChar(20)
  email      String?  @unique @db.VarChar(128)
  password   String   @db.VarChar(255)
  isAdmin    Boolean  @default(false)
  nickName   String   @default("") @db.VarChar(64)
  avatar     String   @default("") @db.VarChar(512)
  status     String   @default("normal") @db.VarChar(20) // normal | disabled
  maxDevices Int      @default(3)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  refreshTokens RefreshToken[]
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique @db.VarChar(255)
  deviceInfo String   @default("") @db.VarChar(255)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
}

model Book {
  id          Int      @id @default(autoincrement())
  title       String
  category    String
  grade       String   @default("")
  subject     String   @default("")
  batchId     String   @default("")
  coverPage   Int      @default(1)
  totalPages  Int
  storagePath String
  fileHash    String?  @db.VarChar(64)
  sourcePaths Json?    @default("[]")
  tocJson     Json
  attributes  Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([fileHash])
  annotations Annotation[]
  mistakes    Mistake[]
}

model Annotation {
  id          Int      @id @default(autoincrement())
  bookId      Int
  book        Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  pageNumber  Int
  type        String
  contentJson Json
  tags        String?
  createdAt   DateTime @default(now())

  mistakes Mistake[]
}

model Mistake {
  id           Int         @id @default(autoincrement())
  annotationId Int
  annotation   Annotation  @relation(fields: [annotationId], references: [id], onDelete: Cascade)
  bookId       Int
  book         Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  pageNumber   Int
  imagePath    String
  subject      String
  tags         String?
  reviewStatus Int         @default(0)
  createdAt    DateTime    @default(now())

  @@index([bookId])
  @@index([annotationId])
  @@index([subject])
}
