generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model User {
  id            Int      @id @default(autoincrement())
  phone         String   @unique @db.VarChar(20)
  email         String?  @unique @db.VarChar(128)
  password      String   @db.VarChar(255)
  isAdmin       Boolean  @default(false)
  role          String   @default("student") @db.VarChar(20) // DEPRECATED: use roles instead
  roles         Json     @default("[]") // ["admin", "teacher", "student"]
  nickName      String   @default("") @db.VarChar(64)
  avatar        String   @default("") @db.VarChar(512)
  status        String   @default("normal") @db.VarChar(20) // normal | disabled
  maxDevices    Int      @default(3)
  tokenVersion  Int      @default(0) // increment to invalidate all existing tokens
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  refreshTokens    RefreshToken[]
  annotations      Annotation[]
  mistakes         Mistake[]
  assignments      Assignment[]
  readingProgress  ReadingProgress[]
  videoProgress    VideoProgress[]
  bookFavorites    BookFavorite[]
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique @db.VarChar(255)
  deviceInfo String   @default("") @db.VarChar(255)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
}

model Book {
  id          Int      @id @default(autoincrement())
  title       String
  category    String
  grade       String   @default("")
  subject     String   @default("")
  batchId     String   @default("")
  /// 资源类型：book = 普通书籍/教辅；course = 带讲解视频的课程资源（PDF + MP4）
  kind        String   @default("book") @db.VarChar(16)
  coverPage   Int      @default(1)
  totalPages  Int
  storagePath String
  fileHash    String?  @db.VarChar(64)
  sourcePaths Json?    @default("[]")
  tocJson     Json
  attributes  Json     @default("{}")
  isDeleted   Boolean  @default(false)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([fileHash])
  @@index([category])
  @@index([grade])
  @@index([subject])
  @@index([kind])
  @@unique([title, category])
  annotations Annotation[]
  mistakes    Mistake[]
  assignments Assignment[]
  readingProgress ReadingProgress[]
  bookFavorites BookFavorite[]
  videos      BookVideo[]
}

/// MP4 讲解视频，关联到某本书。文件不复制，只记录原绝对路径。
model BookVideo {
  id         Int      @id @default(autoincrement())
  bookId     Int
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  title      String   @default("") @db.VarChar(512)
  fileName   String   @default("") @db.VarChar(512)
  /// 当前完整绝对路径（跨平台原生分隔符）
  filePath   String   @db.Text
  /// 导入时的根目录，批量迁移硬盘时按 batchId 整体替换
  rootPath   String   @db.Text
  /// 相对根目录的路径，统一用 / 分隔，与平台无关
  relPath    String   @db.Text
  /// 讲次序号（从文件名解析，可能为空）
  lessonNo   Int?
  sortOrder  Int      @default(0)
  /// 自动匹配置信度 0~1
  matchScore Float    @default(0)
  /// lesson = 精确对应某讲；course = 整本课程视频列表（讲义/合集用）
  scope      String   @default("lesson") @db.VarChar(16)
  /// 文件不存在（目录被移动）时置为 true
  missing    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([bookId])
  @@index([bookId, sortOrder])
}

model Assignment {
  id        Int      @id @default(autoincrement())
  bookId    Int
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("") @db.VarChar(255)
  subject   String   @default("") @db.VarChar(64)
  status    String   @default("draft") @db.VarChar(20) // draft | submitted | graded | returned
  gradedBy  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  gradedAt  DateTime?

  strokes AssignmentStroke[]

  @@index([bookId])
  @@index([userId])
}

model AssignmentStroke {
  id           Int      @id @default(autoincrement())
  assignmentId Int
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  pageNumber   Int
  layer        String   @default("student") @db.VarChar(10) // student | teacher
  tool         String   @default("pen") @db.VarChar(20) // pen | highlighter
  color        String   @default("#000000") @db.VarChar(20)
  width        Float    @default(2)
  points       Json     // [{x, y, p}] normalized 0-1
  createdAt    DateTime @default(now())

  @@index([assignmentId])
  @@index([assignmentId, pageNumber])
}

model Annotation {
  id          Int      @id @default(autoincrement())
  bookId      Int
  book        Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageNumber  Int
  type        String
  contentJson Json
  tags        String?
  createdAt   DateTime @default(now())

  mistakes Mistake[]

  @@index([userId])
  @@index([bookId, pageNumber])
}

model ReadingProgress {
  id         Int      @id @default(autoincrement())
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId     Int
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  pageNumber Int      @default(1)
  pageLayout String   @default("single") @db.VarChar(20) // single | double
  fitMode    String   @default("page") @db.VarChar(20)   // page | width
  rotation   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
}

model Mistake {
  id           Int         @id @default(autoincrement())
  annotationId Int
  annotation   Annotation  @relation(fields: [annotationId], references: [id], onDelete: Cascade)
  bookId       Int
  book         Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  userId       Int?
  user         User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageNumber   Int
  imagePath    String
  subject      String
  tags         String?
  reviewStatus Int         @default(0)
  createdAt    DateTime    @default(now())

  @@index([bookId])
  @@index([annotationId])
  @@index([subject])
  @@index([userId])
}

model BookFavorite {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId    Int
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
}

/// 视频学习进度。
/// 学习以「视频」为主维度：同一个 MP4 常被多本教材引用（当前库里 786 条关联只对应 316 个视频），
/// 所以进度按视频身份记录，看完一讲即同时推进所有引用它的教材；
/// 反过来一本书的学习情况由它关联的多个视频聚合而成（一对一也自然成立）。
model VideoProgress {
  id           Int       @id @default(autoincrement())
  /// 视频身份 = BookVideo.relPath（相对资源根目录的路径，跨盘/跨平台稳定，重定向根目录后不变）
  videoKey     String    @db.VarChar(512)
  userId       Int?
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 播放位置（秒），用于续播
  positionSec  Float     @default(0)
  /// 视频总时长（秒），由播放器上报
  durationSec  Float     @default(0)
  /// 播放比例达到阈值后自动置为「已看完」
  watched      Boolean   @default(false)
  /// 手动标记「已完成」（作业做完 + 错题整理完 后由用户确认）
  completed    Boolean   @default(false)
  completedAt  DateTime?
  lastViewedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([videoKey])
  @@index([userId])
  @@index([userId, videoKey])
}
